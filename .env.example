# API Keys for AirRoute
# Get your keys from the following providers:

# OpenAQ API - https://docs.openaq.org/
NEXT_PUBLIC_OPENAQ_API_KEY=

# WAQI (World Air Quality Index) API - https://aqicn.org/api/
NEXT_PUBLIC_WAQI_API_KEY=f16793f6a12fb8f81ebff94240c584b74a7ad897

# OSRM (Open Source Routing Machine) - Optional if using public demo server
# Public demo: http://router.project-osrm.org
NEXT_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# Map Tiles (Optional if using OpenStreetMap default)
# Mapbox: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
